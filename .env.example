# SIMON — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains your personal credentials.

# ── Azure App Registration ────────────────────────────────────────────────────
# Your Azure Application (client) ID.
# Get this from portal.azure.com → App registrations → SIMON → Overview
AZURE_CLIENT_ID=your-azure-client-id-here

# Leave as "consumers" for personal Microsoft accounts (Outlook, Hotmail, Live).
# Replace with your Azure tenant ID for work or school accounts.
AZURE_TENANT_ID=consumers

# ── OneNote Structure ─────────────────────────────────────────────────────────
# The notebook and section where SIMON saves your conversations.
# These will be created automatically if they don't exist yet.
ONENOTE_DEFAULT_NOTEBOOK=AI
ONENOTE_DEFAULT_SECTION=Claude Conversation

# ── HTTP Server (Claude.ai integration only) ──────────────────────────────────
# Host and port for the HTTP MCP server used with ngrok.
# You do not need to change these unless port 8000 is already in use.
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
